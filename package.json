{
  "name": "promptfoo-showcase",
  "version": "0.1.0",
  "private": true,
  "description": "Demo repo showcasing AI evaluation of Claude skills, agents and commands with Promptfoo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspace backend",
    "eval:commit": "node scripts/pf.mjs eval -c evals/commit-skill/promptfooconfig.yaml --no-cache",
    "eval:changelog": "node scripts/pf.mjs eval -c evals/changelog-skill/promptfooconfig.yaml --no-cache",
    "eval:test-writer": "node scripts/pf.mjs eval -c evals/test-writer-agent/promptfooconfig.yaml --no-cache",
    "eval:analyze": "node scripts/pf.mjs eval -c evals/analyze-command/promptfooconfig.yaml --no-cache",
    "eval:e2e": "node scripts/pf.mjs eval -c evals/agent-sdk-e2e/promptfooconfig.yaml --no-cache",
    "eval:redteam": "node scripts/pf.mjs redteam eval -c evals/redteam/redteam.yaml --no-cache -j 6",
    "eval:redteam:generate": "node scripts/pf.mjs redteam generate -c evals/redteam/promptfooconfig.yaml -o evals/redteam/redteam.yaml --force",
    "eval:compare": "node scripts/pf.mjs eval -c evals/compare-versions/promptfooconfig.yaml --no-cache",
    "eval:all": "node scripts/eval-all.mjs",
    "eval:view": "node scripts/pf.mjs view -y",
    "pf": "node scripts/pf.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "promptfoo": "^0.124.1",
    "js-yaml": "^5.4.2"
  }
}
